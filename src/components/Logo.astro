---
// Assinatura horizontal oficial: monograma + filete + nome (Newsreader) + descritor (Hanken Grotesk).
import Monogram from './Monogram.astro';
interface Props {
  tone?: 'plum' | 'ivory';
  compact?: boolean;
}
const { tone = 'plum', compact = false } = Astro.props;
---
<span class:list={['logo', `logo--${tone}`, { 'logo--compact': compact }]}>
  <Monogram tone={tone} size={44} class="logo__mark" />
  <span class="logo__rule" aria-hidden="true"></span>
  <span class="logo__text">
    <span class="logo__name">Luana Genaro</span>
    <span class="logo__tag">Nutrição de Precisão e Saúde</span>
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.85rem; color: var(--plum); }
  .logo--ivory { color: var(--ivory); }
  :global(.logo__mark) { flex: none; width: 2.75rem; height: 2.75rem; }
  .logo__rule { width: 1px; align-self: stretch; margin-block: 0.15rem; background: currentColor; opacity: 0.22; }
  .logo__text { display: flex; flex-direction: column; gap: 0.3rem; line-height: 1; }
  .logo__name {
    font-family: var(--serif); font-size: 1.5rem; font-weight: 400; letter-spacing: 0.01em;
    font-variation-settings: 'opsz' 36;
  }
  .logo__tag {
    font-family: var(--sans); font-size: 0.5625rem; font-weight: 500; letter-spacing: 0.28em;
    text-transform: uppercase; color: var(--plum-mid);
  }
  .logo--ivory .logo__tag { color: var(--sage); }
  @media (max-width: 420px) {
    .logo--compact .logo__tag { display: none; }
    .logo--compact .logo__name { font-size: 1.3rem; }
    .logo--compact :global(.logo__mark) { width: 2.4rem; height: 2.4rem; }
  }
</style>
