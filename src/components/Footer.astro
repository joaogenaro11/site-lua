---
import Logo from './Logo.astro';
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__main">
      <a href="/" class="site-footer__brand"><Logo tone="ivory" /><span class="visually-hidden">, página inicial</span></a>
      <ul class="site-footer__info">
        <li>{site.title} · {site.crn}</li>
        <li>{site.location}</li>
        <li><a href={site.whatsappUrl} target="_blank" rel="noopener" data-cta="footer">WhatsApp</a></li>
        <li><a href={site.instagramUrl} target="_blank" rel="noopener">Instagram</a></li>
      </ul>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {site.name}. Todos os direitos reservados.</p>
      <p class="site-footer__note">Conteúdo informativo, não substitui consulta individual com profissional de saúde.</p>
      <a href="/politica-de-privacidade">Política de Privacidade</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative; background: var(--graphite); color: rgba(247, 245, 240, 0.72);
    padding-block: 3.25rem 1.5rem; font-size: 0.9rem;
  }
  .site-footer > .container { position: relative; z-index: 1; }
  .site-footer a { color: var(--ivory); text-decoration: none; background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size 0.45s var(--ease-out); }
  .site-footer a:hover { background-size: 100% 1px; }
  .site-footer__brand { background: none !important; display: inline-flex; }
  .site-footer__main {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem 2.5rem;
    padding-bottom: 1.75rem; border-bottom: 1px solid rgba(247, 245, 240, 0.12);
  }
  .site-footer__info { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.75rem; }
  .site-footer__bottom {
    display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; justify-content: space-between; align-items: baseline;
    padding-top: 1.25rem; font-size: 0.78rem; color: rgba(247, 245, 240, 0.55);
  }
  .site-footer__bottom a { font-size: 0.78rem; }
  @media (max-width: 760px) {
    .site-footer { padding-block: 2.5rem 5.75rem; }
    .site-footer__info { flex-direction: column; align-items: flex-start; gap: 0.35rem; }
    .site-footer__bottom { flex-direction: column; gap: 0.4rem; }
  }
</style>
