---
import Logo from './Logo.astro';
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <a href="/" class="site-footer__brand"><Logo tone="ivory" /><span class="visually-hidden">, página inicial</span></a>
      <p class="site-footer__sign">Ciência aplicada à sua individualidade.</p>
    </div>

    <div class="site-footer__grid">
      <div>
        <h2 class="site-footer__label">Profissional</h2>
        <p>{site.name}<br />{site.title} · {site.crn}</p>
      </div>
      <div>
        <h2 class="site-footer__label">Consultório</h2>
        <p>{site.location}</p>
      </div>
      <div>
        <h2 class="site-footer__label">Contato</h2>
        <ul>
          <li><a href={site.whatsappUrl} target="_blank" rel="noopener" data-cta="footer">WhatsApp {site.phoneDisplay}</a></li>
          <li><a href={site.instagramUrl} target="_blank" rel="noopener">Instagram {site.instagramHandle}</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {site.name}. Todos os direitos reservados.</p>
      <p class="site-footer__note">As informações deste site têm caráter informativo e não substituem consulta individual com profissional de saúde.</p>
      <a href="/politica-de-privacidade">Política de Privacidade</a>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--graphite); color: rgba(247, 245, 240, 0.78); padding-block: clamp(4rem, 8vw, 6rem) 2.5rem; font-size: 0.95rem; }
  .site-footer a { color: var(--ivory); text-decoration: none; background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size 0.45s var(--ease-out); }
  .site-footer a:hover { background-size: 100% 1px; }
  .site-footer__brand { background: none !important; display: inline-flex; }
  .site-footer__top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 2rem; padding-bottom: 3rem; border-bottom: 1px solid rgba(247, 245, 240, 0.12); }
  .site-footer__sign { font-family: var(--serif); font-style: italic; font-size: clamp(1.25rem, 2vw, 1.6rem); color: var(--ivory); font-weight: 340; }
  .site-footer__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; padding-block: 3rem; }
  .site-footer__label { font-family: var(--sans); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--sage); margin-bottom: 0.9rem; }
  .site-footer ul { display: grid; gap: 0.35rem; }
  .site-footer__bottom { display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; justify-content: space-between; align-items: baseline; padding-top: 2rem; border-top: 1px solid rgba(247, 245, 240, 0.12); font-size: 0.82rem; color: rgba(247, 245, 240, 0.6); }
  .site-footer__note { flex: 1 1 22rem; max-width: 40rem; }
  @media (max-width: 760px) {
    .site-footer__grid { grid-template-columns: 1fr; }
    .site-footer { padding-bottom: 6.5rem; }
  }
</style>
