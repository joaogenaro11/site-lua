---
// Grafismo do sistema de marca: trajetórias concêntricas incompletas + ponto.
interface Props { class?: string; tone?: 'plum' | 'ivory' | 'sage'; }
const { class: className, tone = 'plum' } = Astro.props;
const c = tone === 'plum' ? '#76519B' : tone === 'ivory' ? '#F7F5F0' : '#A8B99A';
---
<svg class={className} viewBox="0 0 600 600" fill="none" aria-hidden="true" focusable="false">
  <circle cx="300" cy="300" r="270" stroke={c} stroke-width="1" stroke-dasharray="1300 397" stroke-linecap="round" transform="rotate(-30 300 300)" vector-effect="non-scaling-stroke"></circle>
  <circle cx="300" cy="300" r="200" stroke={c} stroke-width="1" stroke-dasharray="900 357" stroke-linecap="round" transform="rotate(120 300 300)" vector-effect="non-scaling-stroke"></circle>
  <circle cx="300" cy="300" r="130" stroke="#B4D936" stroke-width="1.2" stroke-dasharray="420 397" stroke-linecap="round" transform="rotate(200 300 300)" vector-effect="non-scaling-stroke"></circle>
  <circle cx="300" cy="300" r="5" fill="#B4D936"></circle>
</svg>
