---
import Logo from './Logo.astro';
import { site } from '../data/site';
---
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand">
      <Logo compact /><span class="visually-hidden">, página inicial</span>
    </a>

    <a class="btn btn--sm site-header__cta" href={site.whatsappUrl} target="_blank" rel="noopener" data-cta="header">
      <span class="site-header__cta-long">Agendar consulta</span>
      <span class="site-header__cta-short" aria-hidden="true">Agendar</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    transition: background-color 0.5s var(--ease), box-shadow 0.5s var(--ease);
  }
  .site-header.is-scrolled {
    background: rgba(255, 255, 255, 0.92);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    box-shadow: 0 1px 0 var(--line);
  }
  .site-header__inner {
    height: var(--header-h); display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
  }
  .site-header__brand { text-decoration: none; display: inline-flex; }

  /* Logo em destaque no header */
  .site-header__brand :global(.logo) { gap: 1rem; }
  .site-header__brand :global(.logo__mark) { width: 3.25rem; height: 3.25rem; }
  .site-header__brand :global(.logo__name) { font-size: 1.85rem; }
  .site-header__brand :global(.logo__tag) { font-size: 0.625rem; }

  .site-header__cta-short { display: none; }

  @media (max-width: 560px) {
    .site-header__brand :global(.logo__mark) { width: 2.6rem; height: 2.6rem; }
    .site-header__brand :global(.logo__name) { font-size: 1.4rem; }
    .site-header__cta { padding-inline: 1rem; }
    .site-header__cta-long { display: none; }
    .site-header__cta-short { display: inline; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 12);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
